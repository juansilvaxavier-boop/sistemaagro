{
  "name": "agroterra-sistema",
  "version": "1.0.0",
  "description": "ERP web de venda, crédito, cobrança e logística para distribuição de fertilizantes e insumos agrícolas",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "demo": "DEMO=1 node --no-warnings server/index.js",
    "seed:demo": "node --no-warnings server/seed.js --reset",
    "test": "node --no-warnings --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@svg-maps/brazil": "^2.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "municipios-brasil": "^0.2.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
