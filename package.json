{
  "name": "agroterra-sistema",
  "version": "1.0.0",
  "description": "ERP web de venda, crédito, cobrança e logística para distribuição de fertilizantes e insumos agrícolas",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
