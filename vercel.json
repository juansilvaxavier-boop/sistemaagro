{
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/{schema.sql,assistente-manual.md}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/crm",
      "schedule": "30 9 * * *"
    }
  ],
  "regions": [
    "gru1"
  ]
}
